# Optional. Without a key, AI quiz generation is disabled and players can only
# pick existing quizzes (you can still upload quizzes as JSON via POST /api/quiz).
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults to gemini-2.5-flash
# Available models (from your API key):
# gemini-2.0-flash-lite  (fast and cheap)
# gemini-2.0-flash       (better quality)
# gemini-2.5-flash       (default, best quality)
# GEMINI_MODEL=gemini-2.5-flash

# Access codes and roles (bitmask: 1 interactive, 2 generate, 4 upload, 8 admin). Not needed for ./start.sh local play.
# See docs/access-and-quizzes.md
# USERS='{"hunter2":{"name":"alex","role":15}}'
# SCREENS='{"<uuid>":{"label":"Living room","owners":["alex"]}}'
