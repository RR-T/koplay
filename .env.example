# Optional. Without a key, AI quiz generation is disabled and players can only
# pick existing quizzes (you can still upload quizzes as JSON via POST /api/quiz).
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults to gemini-2.0-flash-lite
# Available models (from your API key):
# gemini-2.0-flash-lite  (default, fast and cheap)
# gemini-2.0-flash       (better quality)
# gemini-2.5-flash       (best quality)
# GEMINI_MODEL=gemini-2.0-flash-lite

# Quiz authors: JSON object of {password: username}. The password is the key
# because it identifies you — type it once and the server knows who you are.
# Only listed users can generate new trivia quizzes (costs Gemini tokens) or
# delete their own saved quizzes. Loading existing quizzes is open to all.
# Example: QUIZ_USERS={"hunter2":"alex","correcthorse":"sam"}
QUIZ_USERS={}
