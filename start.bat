@echo off
REM One-command local play for Windows: starts KoPlay + a public tunnel, opens the display.
REM Requires Docker Desktop. Press any key in this window to stop.
setlocal enabledelayedexpansion
cd /d "%~dp0"

set COMPOSE=docker compose -f docker-compose.local.yml
if "%LOCAL_PORT%"=="" set LOCAL_PORT=3000

where docker >nul 2>&1 || ( echo Docker is required: https://docs.docker.com/get-docker/ & pause & exit /b 1 )
docker info >nul 2>&1 || ( echo Docker is installed but not running. Start Docker Desktop and try again. & pause & exit /b 1 )

REM First run: generate a private host code and screen ID.
if not exist .env.local (
  for /f %%i in ('powershell -NoProfile -Command "-join ((48..57)+(65..70) | Get-Random -Count 6 | %%{[char]$_})"') do set CODE=%%i
  for /f %%i in ('powershell -NoProfile -Command "[guid]::NewGuid().ToString('N')"') do set SCREEN=%%i
  > .env.local echo # Generated by start.bat - safe to edit. Not committed to git.
  >> .env.local echo # Host access code: type this on the first phone to join ^(that player becomes host^).
  >> .env.local echo USERS='{"!CODE!":{"name":"Host","role":15}}'
  >> .env.local echo SCREENS='{"!SCREEN!":{"label":"Local screen","owners":["Host"]}}'
  >> .env.local echo # Add a key to enable Trivia quiz generation:
  >> .env.local echo GEMINI_API_KEY=
  echo Created .env.local
)

for /f %%i in ('powershell -NoProfile -Command "(Get-Content .env.local | Select-String '^USERS=').Line -replace '^USERS=.{3}','' -replace '\".*',''"') do set CODE=%%i
for /f %%i in ('powershell -NoProfile -Command "(Get-Content .env.local | Select-String '^SCREENS=').Line -replace '^SCREENS=.{3}','' -replace '\".*',''"') do set SCREEN=%%i
if "%CODE%"=="" ( echo Could not read USERS/SCREENS from .env.local. Delete it to regenerate. & pause & exit /b 1 )

echo Starting KoPlay (first run builds the image, this can take a few minutes)...
%COMPOSE% up --build -d || ( pause & exit /b 1 )

echo Waiting for the public tunnel URL...
set URL=
for /l %%n in (1,1,60) do (
  if not defined URL (
    for /f %%u in ('powershell -NoProfile -Command "(%COMPOSE% logs tunnel 2>&1 | Select-String -Pattern 'https://[a-z0-9-]+\.trycloudflare\.com' | Select-Object -First 1).Matches.Value"') do set URL=%%u
    if not defined URL timeout /t 1 /nobreak >nul
  )
)
if not defined URL ( echo Tunnel did not start. & %COMPOSE% logs tunnel & %COMPOSE% down & pause & exit /b 1 )

echo Waiting for the app...
for /l %%n in (1,1,30) do (
  curl -fs -o nul http://localhost:%LOCAL_PORT%/ && goto :ready
  timeout /t 1 /nobreak >nul
)
:ready

echo.
echo   Display (open on the big screen):  %URL%/screen/%SCREEN%
echo   Phones join at:                    %URL%
echo   Host access code:                  %CODE%   (first player to join types this)
echo.
start "" "%URL%/screen/%SCREEN%"

echo Press any key to stop KoPlay and close the tunnel.
pause >nul
echo Stopping...
%COMPOSE% down >nul 2>&1
